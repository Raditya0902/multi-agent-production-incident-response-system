GROQ_API_KEY=your_groq_api_key_here
INCIDENT_DB_PATH=./incidents.db
MAX_RETRY_ATTEMPTS=3
LLM_MODEL=llama-3.3-70b-versatile
CHROMA_PERSIST_DIR=./rag/chroma_db
SANDBOX_MODE=subprocess
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=4096

# Slack notifications (optional — leave blank to disable)
# Option A: Bot token (create a Slack App, add chat:write scope, install to workspace)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
# Option B: Incoming Webhook URL (simpler — no bot token needed)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
SLACK_INCIDENT_CHANNEL=#incidents
# SLACK_ESCALATION_CHANNEL=#on-call   # defaults to SLACK_INCIDENT_CHANNEL if not set

# GitHub PR creation (optional — leave blank to disable)
# Create a PAT at github.com/settings/tokens with repo scope (or fine-grained: Contents + Pull requests read/write)
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO=owner/repository-name   # e.g. aditya/my-app
GITHUB_BASE_BRANCH=main             # branch the PR targets

# Webhook API (optional — leave blank to disable authentication)
# WEBHOOK_API_KEY=your-secret-key   # pass as X-Api-Key header; empty = no auth (dev mode)

# Fallback LLM (switches automatically when Groq daily quota is exhausted)
# Set FALLBACK_LLM_PROVIDER to "gemini", "openai", or "anthropic" and add the key below.
# Install the matching package first: pip install langchain-google-genai / langchain-openai / langchain-anthropic
FALLBACK_LLM_PROVIDER=       # "gemini" | "openai" | "anthropic" — leave blank to disable
GOOGLE_API_KEY=               # required when FALLBACK_LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash # optional
OPENAI_API_KEY=               # required when FALLBACK_LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini      # optional
ANTHROPIC_API_KEY=            # required when FALLBACK_LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-haiku-4-5-20251001  # optional
