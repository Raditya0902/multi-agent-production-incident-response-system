GROQ_API_KEY=your_groq_api_key_here
INCIDENT_DB_PATH=./incidents.db
CHROMA_PERSIST_DIR=./rag/chroma_db
MAX_RETRY_ATTEMPTS=3
LLM_MODEL=llama-3.3-70b-versatile
SANDBOX_MODE=subprocess
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=4096

# Slack notifications (optional — leave blank to disable)
# Option A: Bot token (create a Slack App, add chat:write scope, install to workspace)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
# Option B: Incoming Webhook URL (simpler — no bot token needed)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
SLACK_INCIDENT_CHANNEL=#incidents
# SLACK_ESCALATION_CHANNEL=#on-call   # defaults to SLACK_INCIDENT_CHANNEL if not set

# GitHub PR creation (optional — leave blank to disable)
# Create a PAT at github.com/settings/tokens with repo scope (or fine-grained: Contents + Pull requests read/write)
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO=owner/repository-name   # e.g. aditya/my-app
GITHUB_BASE_BRANCH=main             # branch the PR targets
