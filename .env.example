# Primary provider (choose one block).
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=4096

# Groq alternative. Set LLM_PROVIDER=groq and uncomment this block.
# GROQ_API_KEY=
# LLM_MODEL=openai/gpt-oss-20b
# GROQ_TEMPERATURE=0.2
# GROQ_MAX_TOKENS=4096

INCIDENT_DB_PATH=./incidents.db
HITL_DB_PATH=./hitl.db
MAX_RETRY_ATTEMPTS=3
CHROMA_PERSIST_DIR=./rag/chroma_db
SANDBOX_MODE=docker
SANDBOX_IMAGE=incident-execution-sandbox:local

# Slack notifications (optional).
SLACK_BOT_TOKEN=
# SLACK_WEBHOOK_URL=
SLACK_INCIDENT_CHANNEL=#incidents
# SLACK_ESCALATION_CHANNEL=#on-call

# GitHub PR creation (optional).
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main

# Webhook authentication (optional).
# WEBHOOK_API_KEY=

# Optional quota fallback. Set the chosen provider's key and model ID.
FALLBACK_LLM_PROVIDER=
# GOOGLE_API_KEY=
# GEMINI_MODEL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
